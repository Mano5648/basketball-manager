# Copy to android/keystore.properties and fill in. That file is gitignored —
# never commit it, and never commit the .jks itself.
#
# Create the key first (run from the android/ folder):
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# Losing this key means you can no longer update the app, so back up the .jks
# and these passwords somewhere safe (a password manager, not this repo).

storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
